{
    "comments": {
        "lineComment": "//",
        "blockComment": [ "/*", "*/" ]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    // Quotes are not auto-closed inside strings or comments. @Description prose
    // is scoped as a string, so without "notIn" every apostrophe typed there
    // ("the material's ...") would insert a second, unwanted one.
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
        { "open": "'", "close": "'", "notIn": ["string", "comment"] },
        { "open": "/**", "close": " */", "notIn": ["string"] }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    // Same region markers as the built-in C++ language configuration.
    "folding": {
        "markers": {
            "start": "^\\s*#pragma\\s+region\\b",
            "end": "^\\s*#pragma\\s+endregion\\b"
        }
    },
    // Continue '/** ... */' doc comments on Enter, as in C++.
    "onEnterRules": [
        {
            "beforeText": { "pattern": "^\\s*/\\*\\*(?!/)([^\\*]|\\*(?!/))*$" },
            "afterText": { "pattern": "^\\s*\\*/$" },
            "action": { "indent": "indentOutdent", "appendText": " * " }
        },
        {
            "beforeText": { "pattern": "^\\s*/\\*\\*(?!/)([^\\*]|\\*(?!/))*$" },
            "action": { "indent": "none", "appendText": " * " }
        },
        {
            "beforeText": { "pattern": "^(\\t|[ ])*[ ]\\*([ ]([^\\*]|\\*(?!/))*)?$" },
            "previousLineText": { "pattern": "(?=^(\\s*(/\\*\\*|\\*)).*)(?=(?!(\\s*\\*/)))" },
            "action": { "indent": "none", "appendText": "* " }
        },
        {
            "beforeText": { "pattern": "^(\\t|[ ])*[ ]\\*/\\s*$" },
            "action": { "indent": "none", "removeText": 1 }
        }
    ]
}
