// Regression fixture: open-ended @Bounds / @PhysicalBounds intervals.
//
// MFront marks an infinite endpoint with an inverted bracket, so `[0:*[`
// contains two '[' and no ']'. Before the fix, that unmatched bracket was
// consumed by source.cpp's `meta.bracket.square.array.cpp` begin/end rule,
// which never found its ']' and stayed open until EOF -- suppressing
// keyword.control.mfront on every @keyword below.
//
// Every line starting with @Xxx in this file must be highlighted.

@DSL Implicit;
@Behaviour BoundsInterval;

@MaterialProperty real k;
@PhysicalBounds k in [0:*[;

@MaterialProperty real nu;
@PhysicalBounds nu in [-1:0.5];

@MaterialProperty real lambda;
@Bounds lambda in [0:*[;

@AuxiliaryStateVariable real sentinel;

@Epsilon 1.e-14;
@Theta 1.0;
